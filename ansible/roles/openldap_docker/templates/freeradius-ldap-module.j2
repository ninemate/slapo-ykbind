ldap {
  server = {{ radius_ldap_server | quote }}
  port = {{ radius_ldap_port }}
  identity = {{ radius_ldap_bind_dn | quote }}
  password = {{ radius_ldap_bind_password | quote }}
  base_dn = {{ radius_ldap_base_dn | quote }}

  user {
    base_dn = {{ radius_ldap_user_base_dn | quote }}
    filter = {{ radius_ldap_user_filter | quote }}
  }

  group {
    base_dn = {{ radius_ldap_group_base_dn | quote }}
    filter = {{ radius_ldap_group_filter | quote }}
    membership_attribute = {{ radius_ldap_group_membership_attribute | quote }}
  }

  options {
    chase_referrals = yes
    rebind = yes
    res_timeout = 10
    net_timeout = 1
    srv_timelimit = 3
    idle = 60
    probes = 3
    interval = 3
  }

  tls {
    start_tls = {{ (radius_ldap_start_tls | bool) | ternary('yes', 'no') }}
    require_cert = {{ radius_ldap_tls_require_cert | quote }}
  }
}
