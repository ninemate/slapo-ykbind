ldap {
  server = {{ radius_ldap_host | quote }}
  port = {{ radius_ldap_port }}
  identity = {{ radius_ldap_bind_dn | quote }}
  password = {{ radius_ldap_bind_password | quote }}
  base_dn = {{ radius_ldap_base_dn | quote }}

  update {
    control:Password-With-Header += 'userPassword'
    control:NT-Password := 'ntPassword'
    reply:Reply-Message := 'radiusReplyMessage'
    reply:Tunnel-Type := 'radiusTunnelType'
    reply:Tunnel-Medium-Type := 'radiusTunnelMediumType'
    reply:Tunnel-Private-Group-ID := 'radiusTunnelPrivategroupId'
    reply:Juniper-Local-User-Name := 'radiusUserCategory'
    reply:Symbol-Admin-Role := 'hvfoSymbolAdminRole'
    reply:MBG-Management-Privilege-Level := 'hvfoMeinbergManagementPrivilegeLevel'
    reply:CP-Gaia-User-Role := 'hvfoCPGaiaUserRole'
    reply:CP-Gaia-SuperUser-Access := 'hvfoCPGaiaSuperUserAccess'
    reply:Class := 'radiusClass'
  }

  user {
    base_dn = "${..base_dn}"
    filter = {{ radius_ldap_user_filter | quote }}
  }

  group {
    base_dn = {{ radius_ldap_group_base_dn | quote }}
    filter = {{ radius_ldap_group_filter | quote }}
    membership_attribute = {{ radius_ldap_group_membership_attribute | quote }}
  }

  profile {
  }

  client {
    base_dn = {{ radius_clients_base_dn | quote }}
    filter = {{ radius_ldap_client_filter | quote }}
    attribute {
      identifier = {{ radius_ldap_client_identifier_attribute | quote }}
      secret = {{ radius_ldap_client_secret_attribute | quote }}
    }
  }

  accounting {
    reference = "%{tolower:type.%{Acct-Status-Type}}"
    type {
      start {
        update {
          description := "Online at %S"
        }
      }
      interim-update {
        update {
          description := "Last seen at %S"
        }
      }
      stop {
        update {
          description := "Offline at %S"
        }
      }
    }
  }

  post-auth {
    update {
      description := "Authenticated at %S"
    }
  }

  options {
    chase_referrals = yes
    rebind = yes
    res_timeout = 10
    net_timeout = 1
    srv_timelimit = 3
    idle = 60
    probes = 3
    interval = 3
    ldap_debug = 0x0028
  }

  pool {
    start = 5
    min = 4
    max = ${thread[pool].max_servers}
    spare = 3
    uses = 0
    lifetime = 0
    idle_timeout = 60
  }

  tls {
    start_tls = {{ (radius_ldap_start_tls | bool) | ternary('yes', 'no') }}
    require_cert = {{ radius_ldap_tls_require_cert | quote }}
  }
}
