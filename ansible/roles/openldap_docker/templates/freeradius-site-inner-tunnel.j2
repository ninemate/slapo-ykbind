server inner-tunnel {
  listen {
    ipaddr = 127.0.0.1
    port = 18120
    type = auth
  }

  authorize {
    if (&CHAP-Password || &MS-CHAP-Challenge || &MS-CHAP-Response) {
      update reply {
        Reply-Message := "Use PAP for LDAP-backed tunneled RADIUS login"
      }
      reject
    }
    chap
    mschap
    suffix
    eap {
      ok = return
    }
    files
    ldap
    if ((ok || updated) && &User-Password) {
      update control {
        Auth-Type := LDAP
      }
    }
  }

  authenticate {
    Auth-Type PAP {
      pap
    }

    Auth-Type CHAP {
      chap
    }

    Auth-Type MS-CHAP {
      mschap
    }

    Auth-Type LDAP {
      ldap
    }

    eap
  }

  session {
  }

  post-auth {
    ldap
  }

  Post-Auth-Type REJECT {
    attr_filter.access_reject
  }
}
