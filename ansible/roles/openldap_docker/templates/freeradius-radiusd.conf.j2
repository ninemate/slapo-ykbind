prefix = /usr
exec_prefix = /usr
sysconfdir = /etc
localstatedir = /var
sbindir = ${exec_prefix}/sbin
logdir = {{ radius_container_log_dir }}
raddbdir = {{ radius_container_config_dir }}
radacctdir = ${logdir}/radacct

name = freeradius
confdir = ${raddbdir}
modconfdir = ${confdir}/mods-config
certdir = ${confdir}/certs
cadir = ${confdir}/certs
run_dir = {{ radius_container_run_dir }}
db_dir = ${raddbdir}
libdir = /usr/lib/freeradius
pidfile = ${run_dir}/${name}.pid
correct_escapes = true

max_request_time = 30
cleanup_delay = 5
max_requests = 16384
hostname_lookups = no

log {
  destination = {{ radius_log_destination }}
  colourise = yes
  file = ${logdir}/radius.log
  syslog_facility = daemon
  stripped_names = no
  auth = {{ (radius_log_auth_requests | bool) | ternary('yes', 'no') }}
  auth_badpass = {{ (radius_log_auth_badpass | bool) | ternary('yes', 'no') }}
  auth_goodpass = {{ (radius_log_auth_goodpass | bool) | ternary('yes', 'no') }}
  msg_denied = "You are already logged in - access denied"
}

checkrad = ${sbindir}/checkrad

security {
  user = {{ radius_runtime_user }}
  group = {{ radius_runtime_group }}
  allow_core_dumps = no
  max_attributes = 200
  reject_delay = 1
  status_server = yes
}

proxy_requests = yes
$INCLUDE proxy.conf
$INCLUDE clients.conf

thread pool {
  start_servers = 5
  max_servers = 32
  min_spare_servers = 3
  max_spare_servers = 10
  max_requests_per_server = 0
  auto_limit_acct = no
}

modules {
  $INCLUDE mods-enabled/
}

instantiate {
  exec
  expr
  expiration
  logintime
}

policy {
  $INCLUDE policy.d/
}

$INCLUDE sites-enabled/
