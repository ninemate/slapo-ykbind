server default {
  listen {
    type = auth
    ipaddr = *
    port = {{ radius_container_auth_port }}
  }

  listen {
    type = acct
    ipaddr = *
    port = {{ radius_container_acct_port }}
  }

  authorize {
    preprocess
    if (&CHAP-Password || &MS-CHAP-Challenge || &MS-CHAP-Response) {
      update reply {
        Reply-Message := "Use PAP for LDAP-backed RADIUS login"
      }
      reject
    }
    chap
    mschap
    digest
    suffix
    eap {
      ok = return
    }
    files
    expiration
    logintime
    ldap
    if ((ok || updated) && &User-Password) {
{% if radius_yubikey_nas_bypass_enabled | bool %}
      if ("%{ldap:ldap://{{ radius_ldap_host_effective }}:{{ ldap_container_ldap_port }}/{{ radius_clients_base_dn }}?yubiKeyNasBypass?sub?(|(cn=%{NAS-Identifier})(cn=%{NAS-IP-Address}))}" == "TRUE") {
        update control {
          Auth-Type := PAP
          Cleartext-Password := "%{ldap:userPassword}"
        }
      }
      else {
        update control {
          Auth-Type := LDAP
        }
      }
{% else %}
      update control {
        Auth-Type := LDAP
      }
{% endif %}
    }
  }

  authenticate {
    Auth-Type PAP {
      pap
    }

    Auth-Type CHAP {
      chap
    }

    Auth-Type MS-CHAP {
      mschap
    }

    Auth-Type LDAP {
      ldap
    }

    digest
    eap
  }

  preacct {
    preprocess
    suffix
  }

  accounting {
    detail
    ldap
  }

  session {
  }

  post-auth {
    ldap
  }

  Post-Auth-Type REJECT {
    attr_filter.access_reject
  }
}
